# ─────────────────────────────────────────────────────────────
# Automotive CX Platform — variables de entorno
# Copiar a .env.local (desarrollo) y cargar en Vercel (prod).
# NUNCA versionar .env.local ni la service role key.
# ─────────────────────────────────────────────────────────────

# --- Aplicación ---------------------------------------------------
# Nombre visible del sistema (editable después desde Configuración).
NEXT_PUBLIC_APP_NAME="Automotive Customer Experience Platform"
NEXT_PUBLIC_APP_SHORT_NAME="Automotive CX"
# URL pública absoluta (necesaria para callbacks de auth y enlaces del PDF).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# development | preview | production
APP_ENV="development"

# --- Supabase (cliente, expuesto al navegador) --------------------
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# --- Supabase (solo servidor) -------------------------------------
# Ignora RLS. Solo para scripts de migración/seed y tareas de sistema.
# Jamás debe importarse desde un componente cliente.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# --- PostgreSQL directo (migraciones Drizzle) ---------------------
# Connection string con pooler para runtime, directa para migraciones.
DATABASE_URL="postgresql://postgres:password@db.xxxxxxxx.supabase.co:5432/postgres"

# --- Seguridad ----------------------------------------------------
# Clave HMAC para derivar el hash de búsqueda del documento (DNI).
# 32+ bytes aleatorios: openssl rand -base64 48
DOCUMENT_HASH_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# --- Datos demo ---------------------------------------------------
# Cuando es "true" se permite sembrar y mostrar registros marcados como DEMO.
ENABLE_DEMO_DATA="true"
