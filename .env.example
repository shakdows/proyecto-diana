# ─────────────────────────────────────────────────────────────
# Diana — variables de entorno
# Copiar a .env.local (desarrollo) y cargar en Vercel (producción).
# NUNCA versionar .env.local ni la service role key.
#
# Se validan con Zod al arrancar (src/lib/env.ts): un despliegue mal
# configurado falla de inmediato y con detalle, en vez de romperse a
# mitad de una recepción.
# ─────────────────────────────────────────────────────────────

# --- Aplicación ---------------------------------------------------
# Nombre visible. Desde la Fase 3 se administra en `app_settings`.
NEXT_PUBLIC_APP_NAME="Diana"

# --- Supabase (cliente, expuesto al navegador) --------------------
# Necesarias desde la FASE 3.
# Estas DOS son las que encienden la autenticación real. No son secretas: la
# clave publicable viaja al navegador a propósito, y todo lo que se puede
# hacer con ella lo decide RLS. Mientras falten, el sistema sigue en modo
# demostración —se entra eligiendo puesto— en vez de quedarse en blanco.
NEXT_PUBLIC_SUPABASE_URL="https://yhicfotjqucrgmzgppox.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InloaWNmb3RqcXVjcmdtemdwcG94Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODkxNDQwODYsImV4cCI6MjEwNDcyMDA4Nn0.bVEMkLyUcN3QJrCHKhUShKFTeeqiQyNwcoQuXIbqLGc"

# --- Supabase (solo servidor) -------------------------------------
# Ignora RLS. Solo para scripts de migración, seed y alta de usuarios
# (`npm run db:user`), NUNCA en runtime. Jamás debe importarse desde un
# componente cliente, ni cargarse en Vercel: la aplicación no la usa.
# Se copia del panel de Supabase → Project Settings → API.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# --- PostgreSQL directo (migraciones Drizzle) ---------------------
# Necesaria desde la FASE 2. Conexión directa, no el pooler: las
# migraciones usan sentencias que el pooler en modo transacción no admite.
DATABASE_URL="postgresql://postgres:CONTRASEÑA@db.yhicfotjqucrgmzgppox.supabase.co:5432/postgres"

# --- Seguridad ----------------------------------------------------
# Clave HMAC para derivar el hash de búsqueda del documento de identidad.
# Permite buscar por DNI sin leer el DNI. Necesaria desde la FASE 4.
# 32 bytes o más:  openssl rand -base64 48
DOCUMENT_HASH_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# --- Datos de demostración ----------------------------------------
# Solo "true" los activa. En producción va en "false", y además cada fila
# lleva is_demo = true, de modo que ninguna consulta los mezcla.
ENABLE_DEMO_DATA="false"

# --- CI -----------------------------------------------------------
# Escape para que el build de integración continua no exija secretos.
# SKIP_ENV_VALIDATION="true"
